{
  "name": "demo-anions-ic",
  "analysis_id": 1,
  "prep_method": null,
  "max_batch_size": 20,
  "steps": [
    {
      "step": "cup_shape@1"
    },
    {
      "step": "agreement@1",
      "params": {
        "switch_multiple": "5",
        "rpd_limit": "0.20",
        "absolute_multiple": "1"
      }
    },
    {
      "step": "cup_choice@1",
      "params": {
        "rungs": [
          "spike_witness"
        ],
        "spike_precision": "0.05",
        "scale_fault": {
          "enabled": false
        }
      }
    },
    {
      "step": "recovery@1",
      "params": {
        "not_evaluable_multiple": "4"
      }
    },
    {
      "step": "recovery_pooling@1",
      "params": {
        "window_low": "0.80",
        "window_high": "1.20"
      }
    },
    {
      "step": "reported_value@2",
      "params": {
        "default_places": 3,
        "places": [],
        "ql_multiple": "3.33"
      }
    },
    {
      "step": "uncertainty@1"
    },
    {
      "step": "method_blank@1",
      "params": {
        "multiple": "10"
      }
    },
    {
      "step": "qc_check@1",
      "params": {
        "check": {"low": "0.75", "high": "1.25", "required": false},
        "crm": {"low": "0.75", "high": "1.25", "required": false}
      }
    },
    {
      "step": "spec_limits@1"
    }
  ],
